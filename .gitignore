# =============================================================================
# .gitignore for rag-at-scale
# A learning project for agentic RAG with local models.
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this.txt
*.log

# -----------------------------------------------------------------------------
# Virtual environments
# -----------------------------------------------------------------------------
.env
.envrc
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# -----------------------------------------------------------------------------
# Jupyter
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# -----------------------------------------------------------------------------
# IDEs and editors
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.spyderproject
.spyproject
.ropeproject

# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db

# -----------------------------------------------------------------------------
# Testing / coverage
# -----------------------------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/
.ruff_cache/

# -----------------------------------------------------------------------------
# ML / RAG generated artifacts (do not commit models, indexes, or outputs)
# -----------------------------------------------------------------------------

# Hugging Face cache (if stored inside the project)
learning_data/hf/
learning_data/datasets/

# LanceDB vector indexes
learning_data/artifacts/lancedb/
learning_data/artifacts/**/*.lance
learning_data/artifacts/**/data/

# Serialized indexes and checkpoints
learning_data/artifacts/**/*.pkl
learning_data/artifacts/**/*.json
learning_data/artifacts/**/*.pt
learning_data/artifacts/**/*.safetensors

# Result outputs and figures
learning_data/out/
learning_scratch/

# Run manifests and logs
results/
run_manifest.json
*.log

# -----------------------------------------------------------------------------
# Project-specific helpers (not part of the shared codebase)
# -----------------------------------------------------------------------------
download_models.py
upload_to_hub.py
